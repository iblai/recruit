# ibl.ai/recruit — copy to .env.local (gitignored). Everything NEXT_PUBLIC_* is
# optional against hosted iblai.app; the defaults live in lib/iblai/config.ts.
# No server secrets: agent setup mints the Chief of Staff's key, and the
# platform holds it.

# Self-hosted platform: the consolidated API origin (/dm, /lms, /axd are derived)
# NEXT_PUBLIC_API_BASE_URL=https://api.iblai.app
# NEXT_PUBLIC_AUTH_URL=https://login.iblai.app
# NEXT_PUBLIC_PLATFORM_BASE_DOMAIN=iblai.app

# The community organization — where a user lands when nothing else resolves.
NEXT_PUBLIC_MAIN_TENANT_KEY=main

# The public origin of THIS deployment. Used in landing-page links and as the
# URL the platform's agent runtime calls back on for tools (https in production).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# `app=` sent to the Auth SPA (the OS's value; every organization can sign in).
# NEXT_PUBLIC_IBL_PLATFORM=mentor

# Links out to the Agentic OS (agent settings, billing, org admin).
# NEXT_PUBLIC_OS_URL=https://os.ibl.ai

# Native shells: deep-link scheme the Auth SPA returns through on mobile.
# NEXT_PUBLIC_TAURI_CUSTOM_SCHEME=iblai-recruit

# Pin the Chief of Staff agent at build time instead of reading it from the
# organization's metadata (the UUID at the end of its os.ibl.ai URL).
# NEXT_PUBLIC_DEFAULT_AGENT_ID=

# NEXT_PUBLIC_DEFAULT_CURRENCY=USD
# NEXT_PUBLIC_ENABLE_RBAC=false
# NEXT_PUBLIC_SUPPORT_EMAIL=support@ibl.ai
